# Set this in Cloudflare Workers Builds so Astro generates production URLs in metadata and sitemap.
PUBLIC_SITE_URL=https://your-production-domain.example

# Neon Postgres connection string (admin data, texts and admin users).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&channel_binding=require"
# Signs admin session cookies. At least 32 characters: openssl rand -base64 32
SESSION_SECRET=""

# Neon Object Storage (S3-compatible) for supplier logos.
S3_ENDPOINT="https://<branch>.storage.<region>.aws.neon.tech"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="eu-central-1"
S3_BUCKET="images"
