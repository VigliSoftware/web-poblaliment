{
  "name": "poblaliment-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "check": "astro check",
    "test": "node --test scripts/*.test.mjs && node scripts/verify-page-images.mjs && pnpm build && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "media:optimize": "node scripts/optimize-media.mjs",
    "predeploy:cloudflare": "node --env-file-if-exists=.env scripts/validate-production-url.mjs",
    "deploy:cloudflare": "wrangler deploy",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "db:setup": "node --env-file=.env scripts/db-setup.ts",
    "admin:create": "node --env-file=.env scripts/create-admin.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "astro": "^7.4.2",
    "aws4fetch": "^1.0.20",
    "gsap": "^3.15.0",
    "image-size": "^2.0.4",
    "motion": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.3"
  }
}
