---
import '../styles/global.css';

interface Props {
  title: string;
  active?: 'suppliers' | 'categories' | 'home' | 'texts';
  notice?: string | null;
  error?: string | null;
}

const { title, active, notice, error } = Astro.props;
const signedIn = Boolean(Astro.locals.adminUser);
const links = [
  { key: 'suppliers', label: 'Proveïdors', href: '/admin/proveidors/' },
  { key: 'categories', label: 'Categories', href: '/admin/categories/' },
  { key: 'home', label: 'Marques d’inici', href: '/admin/inici/' },
  { key: 'texts', label: 'Textos', href: '/admin/textos/' },
];
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/images/logo.jpg">
    <title>{title} · Admin Poblaliment</title>
  </head>
  <body class="admin">
    <header class="border-b rule bg-[var(--color-paper-deep)]">
      <div class="admin-frame flex flex-wrap items-center justify-between gap-4 py-4">
        <a href="/admin/" class="flex items-center gap-3 no-underline">
          <img src="/images/logo.jpg" alt="" width="40" height="40" class="h-10 w-10 rounded-full">
          <span class="text-sm font-semibold tracking-[0.14em] text-[var(--color-blue)]">
            POBLALIMENT · ADMIN
          </span>
        </a>
        {signedIn && (
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
            <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Administració">
              {links.map((link) => (
                <a
                  href={link.href}
                  class:list={[
                    'no-underline hover:text-[var(--color-orange)]',
                    active === link.key
                      ? 'font-semibold text-[var(--color-ink)]'
                      : 'text-[var(--color-ink-soft)]',
                  ]}
                  aria-current={active === link.key ? 'page' : undefined}
                >
                  {link.label}
                </a>
              ))}
            </nav>
            <a href="/" target="_blank" rel="noopener" class="text-[var(--color-blue)]">
              Veure la web ↗
            </a>
            <form method="post" action="/admin/logout/">
              <button type="submit" class="admin-link">
                Sortir
              </button>
            </form>
          </div>
        )}
      </div>
    </header>

    <main class="admin-frame py-10">
      <h1 class="display text-4xl sm:text-5xl">{title}</h1>
      {notice && (
        <p class="admin-alert admin-alert--ok" role="status">
          {notice}
        </p>
      )}
      {error && (
        <p class="admin-alert admin-alert--error" role="alert">
          {error}
        </p>
      )}
      <div class="mt-8">
        <slot />
      </div>
    </main>
  </body>
</html>

<style is:global>
.admin-frame {
  width: min(100% - 2rem, 72rem);
  margin-inline: auto;
}

.admin label {
  display: block;
}

.admin-input {
  display: block;
  width: 100%;
  margin-top: 0.35rem;
  padding: 0.6rem 0.75rem;
  border: 1px solid var(--line);
  border-radius: 0.375rem;
  background: #fff;
  color: var(--color-ink);
  font: inherit;
}

.admin-input:focus {
  outline: 2px solid var(--color-orange);
  outline-offset: 1px;
}

textarea.admin-input {
  min-height: 6rem;
  resize: vertical;
}

.admin-button {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.6rem 1.1rem;
  border-radius: 0.375rem;
  background: var(--color-blue);
  color: var(--color-paper);
  font-size: 0.875rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
}

.admin-button:hover {
  background: var(--color-ink);
}

.admin-button--ghost {
  border: 1px solid var(--line);
  background: transparent;
  color: var(--color-ink);
}

.admin-button--ghost:hover {
  background: var(--color-paper-deep);
}

.admin-button--danger {
  background: #a3321b;
}

.admin-link {
  color: var(--color-ink-soft);
  text-decoration: underline;
  cursor: pointer;
}

.admin-alert {
  margin-top: 1.25rem;
  padding: 0.75rem 1rem;
  border-radius: 0.375rem;
  border-left: 4px solid;
}

.admin-alert--ok {
  border-color: var(--color-green);
  background: rgba(22, 138, 98, 0.1);
}

.admin-alert--error {
  border-color: #a3321b;
  background: rgba(163, 50, 27, 0.1);
}

.admin-card {
  padding: 1.25rem;
  border: 1px solid var(--line);
  border-radius: 0.5rem;
  background: #fff;
}

.admin-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
}

.admin-table th,
.admin-table td {
  padding: 0.6rem 0.5rem;
  border-bottom: 1px solid var(--line);
  text-align: left;
  vertical-align: middle;
}

.admin-table th {
  color: var(--color-ink-soft);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.admin-scroll {
  overflow-x: auto;
}

.admin-logo {
  display: grid;
  width: 2.75rem;
  height: 2.75rem;
  place-items: center;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 0.375rem;
  background: #fff;
}

.admin-logo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
</style>
