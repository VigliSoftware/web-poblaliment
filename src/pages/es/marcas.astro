---
import PageIntro from '../../components/PageIntro.astro';
import SupplierMark from '../../components/SupplierMark.astro';
import { content } from '../../data/content';
import { supplierCategories, suppliers } from '../../data/suppliers';
import Layout from '../../layouts/Layout.astro';

const locale = 'es';
const copy = content[locale].brands;
const drinkCategories = supplierCategories.filter((category) =>
  ['Celler', 'Cerveses'].includes(category),
);
const foodCategories = supplierCategories.filter((category) => !drinkCategories.includes(category));
---

<Layout locale={locale} title={copy.title} description={copy.description}>
  <PageIntro
    heading={copy.heading}
    intro={copy.intro}
    image="/images/products-ubla.jpeg"
    imageAlt={copy.imageAlt}
    imageCaption={copy.imageCaption}
    compact
  />
  <section class="page-frame pb-8 sm:pb-16">
    <p class="eyebrow border-b rule pb-4">{copy.note}</p>
    <nav class="supplier-jump-links" aria-label="Categorías de proveedores">
      {supplierCategories.map((category, index) => (
        <a href={`#categoria-${index}`}>
          {suppliers.find((supplier) => supplier.category === category)?.categoryEs}
        </a>
      ))}
    </nav>
    <div class="supplier-columns">
      {[
        { title: 'Vinos y bebidas', categories: drinkCategories },
        { title: 'Alimentación', categories: foodCategories },
      ].map((group) => (
        <div data-reveal>
          <h2 class="display supplier-column-title">{group.title}</h2>
          {group.categories.map((category) => {
            const index = supplierCategories.indexOf(category);
            return (
              <section class="supplier-group" id={`categoria-${index}`}>
                <h3 class="display supplier-group-title">
                  {suppliers.find((supplier) => supplier.category === category)?.categoryEs}
                </h3>
                <div class="supplier-directory">
                  {suppliers
                    .filter((supplier) => supplier.category === category)
                    .map((supplier) => (
                      <article class="supplier-directory-row">
                        <SupplierMark supplier={supplier} />
                        <h4 class="display">{supplier.name}</h4>
                        {supplier.website ? (
                          <a
                            href={supplier.website}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`Visitar la web de ${supplier.name} (se abre en una pestaña nueva)`}
                          >
                            Visitar web <span aria-hidden="true">↗</span>
                          </a>
                        ) : (
                          <span>Web pendiente de confirmar</span>
                        )}
                      </article>
                    ))}
                </div>
              </section>
            );
          })}
        </div>
      ))}
    </div>
  </section>
</Layout>
