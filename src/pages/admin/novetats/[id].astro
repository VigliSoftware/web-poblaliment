---
import LogoUpload from '../../../components/LogoUpload.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { errorMessage, FormError, published, text } from '../../../lib/admin';
import { type Novelty, NoveltyError, readNovelty, replaceNovelty } from '../../../lib/novelties';
import { loadNovelties, saveNovelties } from '../../../lib/novelties-store';
import {
  maxPageImageBytes,
  PageImageError,
  pageImageAccept,
  readPageImage,
} from '../../../lib/page-image-files';
import { pageImageUrl } from '../../../lib/page-images';
import { deleteObject, putObject } from '../../../lib/storage';

const id = Astro.params.id;
if (!id) return Astro.redirect('/admin/novetats/');
const creating = id === 'nova';
const record = await loadNovelties();
const existing = record.data.items.find((item) => item.id === id);
if (!creating && !existing) return Astro.redirect('/admin/novetats/');
const emptyCopy = () => ({ kicker: '', title: '', body: '', link: '', href: '', imageAlt: '' });
let item: Novelty = existing ?? {
  id: crypto.randomUUID(),
  section: 'food',
  active: false,
  order: 10,
  image: { src: '', width: 1, height: 1, type: 'image/jpeg' },
  copy: { ca: emptyCopy(), es: emptyCopy() },
};
let error: string | null = null;
if (Astro.request.method === 'POST') {
  let uploadedKey: string | undefined;
  try {
    if (Number(Astro.request.headers.get('Content-Length')) > maxPageImageBytes + 262144)
      throw new FormError('La imatge no pot superar 5 MB.');
    const form = await Astro.request.formData();
    // Keep entered copy when validation fails; a file must be selected again.
    for (const locale of ['ca', 'es'] as const) {
      for (const key of ['kicker', 'title', 'body', 'link', 'href', 'imageAlt'] as const)
        item.copy[locale][key] = text(form, `${locale}|${key}`);
    }
    item.active = form.has('active');
    item.section = text(form, 'section') === 'cellar' ? 'cellar' : 'food';
    item.order = Number(text(form, 'order'));
    if (Number(text(form, 'revision')) !== record.revision)
      throw new NoveltyError('Una altra sessió ha fet canvis. Recarrega la pàgina abans de desar.');
    const next = readNovelty(form, item.id, item.image);
    const file = form.get('image');
    if (file instanceof File && file.size) {
      const image = await readPageImage(file);
      uploadedKey = `pages/novelty-${crypto.randomUUID()}.${image.extension}`;
      await putObject(uploadedKey, image.body, image.type);
      next.image = {
        src: pageImageUrl(uploadedKey),
        width: image.width,
        height: image.height,
        type: image.type,
      };
    } else if (creating) throw new FormError('Selecciona una foto per a la novetat.');
    await saveNovelties(replaceNovelty(record.data, next), record.revision);
    published();
    return Astro.redirect('/admin/novetats/?ok=1');
  } catch (caught) {
    if (uploadedKey) {
      try {
        await deleteObject(uploadedKey);
      } catch (cleanup) {
        console.error('Could not remove failed novelty upload', cleanup);
      }
    }
    if (
      !(caught instanceof NoveltyError) &&
      !(caught instanceof PageImageError) &&
      !(caught instanceof FormError)
    )
      console.error(caught);
    error =
      caught instanceof NoveltyError || caught instanceof PageImageError
        ? caught.message
        : errorMessage(caught);
  }
}
const fields = [
  { key: 'kicker', label: 'Etiqueta', required: false },
  { key: 'title', label: 'Títol', required: true },
  { key: 'body', label: 'Text', required: true },
  { key: 'imageAlt', label: 'Text alternatiu de la foto (ALT)', required: true },
  { key: 'link', label: 'Text de l’enllaç', required: false },
  { key: 'href', label: 'URL de l’enllaç', required: false },
] as const;
---

<AdminLayout
  title={creating ? 'Afegir novetat' : 'Editar novetat'}
  active="novelties"
  error={error}
>
  <a href="/admin/novetats/" class="admin-link">Tornar a Novetats</a>
  <form method="post" enctype="multipart/form-data" class="mt-7">
    <input type="hidden" name="revision" value={record.revision}>
    <fieldset class="grid items-end gap-5 border-b rule pb-7 sm:grid-cols-3">
      <legend class="mb-4 text-lg font-semibold">On es mostra</legend>
      <label
        >Pàgina
        <select name="section" class="admin-input">
          <option value="food" selected={item.section === 'food'}>Alimentació</option>
          <option value="cellar" selected={item.section === 'cellar'}>Celler</option>
        </select></label
      >
      <label
        >Ordre
        <input
          type="number"
          name="order"
          class="admin-input"
          value={item.order}
          min="0"
          max="100000"
          step="1"
          required
        ><span class="text-sm text-[var(--color-ink-soft)]"
          >Els números més baixos apareixen primer.</span
        ></label
      >
      <label class="flex! items-center gap-3 py-3"
        ><input type="checkbox" name="active" checked={item.active}>
        Mostrar a la web</label
      >
    </fieldset>
    <fieldset class="border-b rule py-7">
      <legend class="pt-7 text-lg font-semibold">Foto compartida entre els dos idiomes</legend>
      <div class="grid items-start gap-6 sm:grid-cols-[16rem_minmax(0,1fr)]">
        <img
          id="novelty-preview"
          src={item.image.src || undefined}
          alt={item.copy.ca.imageAlt || 'Previsualització de la foto'}
          width={item.image.width}
          height={item.image.height}
          class="aspect-[4/3] w-full bg-[var(--color-paper-deep)] object-contain"
        >
        <LogoUpload
          name="image"
          id="novelty-image"
          previewId="novelty-preview"
          accept={pageImageAccept}
          help="PNG, JPG, WebP, AVIF o SVG, fins a 5 MB. La foto es puja quan deses la novetat. Si no selecciones una altra foto, es conserva l’actual."
        />
      </div>
      {error && (
        <p class="mt-3 text-sm">
          Si havies seleccionat una foto nova, torna-la a seleccionar abans de desar.
        </p>
      )}
    </fieldset>
    <div class="grid gap-8 py-7 sm:grid-cols-2">
      {(['ca', 'es'] as const).map((locale) => (
        <fieldset>
          <legend class="text-lg font-semibold">{locale === 'ca' ? 'Català' : 'Castellano'}</legend>
          <div class="mt-5 space-y-5">
            {fields.map(({ key, label, required }) => (
              <label for={`${locale}-${key}`}>
                {label}
                {required && ' *'}
                {key === 'body' ? (
                  <textarea
                    class="admin-input"
                    id={`${locale}-${key}`}
                    name={`${locale}|${key}`}
                    rows="6"
                    maxlength="10000"
                    required={required}
                    set:text={item.copy[locale][key]}
                  />
                ) : (
                  <input
                    class="admin-input"
                    id={`${locale}-${key}`}
                    name={`${locale}|${key}`}
                    type={key === 'href' ? 'url' : 'text'}
                    value={item.copy[locale][key]}
                    maxlength="10000"
                    required={required}
                  />
                )}
              </label>
            ))}
          </div>
        </fieldset>
      ))}
    </div>
    <div class="sticky bottom-0 flex gap-4 border-t rule bg-[var(--color-paper)] py-4">
      <button class="admin-button" type="submit">Desar novetat</button>
      <a class="admin-button admin-button--ghost" href="/admin/novetats/">Cancel·lar</a>
    </div>
  </form>
</AdminLayout>
