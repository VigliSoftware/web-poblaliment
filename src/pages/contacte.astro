---
import PageIntro from '../components/PageIntro.astro';
import { content } from '../data/content';
import Layout from '../layouts/Layout.astro';

const locale = 'ca';
const copy = content[locale].contact;
---

<Layout locale={locale} title={copy.title} description={copy.description}>
  <PageIntro
    heading={copy.heading}
    intro={copy.intro}
    image="/images/contact.jpg"
    imageAlt={copy.imageAlt}
    imageCaption={copy.imageCaption}
    compact
  />

  <section class="page-frame grid gap-12 border-t rule py-12 sm:grid-cols-[1.2fr_0.8fr] sm:py-20">
    <div>
      <h2 class="display text-4xl sm:text-5xl">{copy.formTitle}</h2>
      <p class="mt-3 text-sm text-[var(--color-ink-soft)]">{copy.formNote}</p>
      <form class="mt-8 max-w-xl space-y-7" onsubmit="return false">
        <label class="block text-sm font-semibold" for="name">
          {copy.fields.name}
          <input
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            class="mt-2 w-full border-b-2 border-[var(--color-ink)] bg-transparent px-0 py-3 text-lg outline-none placeholder:text-[var(--color-ink-soft)] focus:border-[var(--color-orange)]"
            placeholder=""
          >
        </label>
        <label class="block text-sm font-semibold" for="email">
          {copy.fields.email}
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            class="mt-2 w-full border-b-2 border-[var(--color-ink)] bg-transparent px-0 py-3 text-lg outline-none placeholder:text-[var(--color-ink-soft)] focus:border-[var(--color-orange)]"
            placeholder=""
          >
        </label>
        <label class="block text-sm font-semibold" for="message">
          {copy.fields.message}
          <textarea
            id="message"
            name="message"
            rows="4"
            class="mt-2 w-full resize-y border-b-2 border-[var(--color-ink)] bg-transparent px-0 py-3 text-lg outline-none focus:border-[var(--color-orange)]"
          ></textarea>
        </label>
        <button
          type="submit"
          class="bg-[var(--color-blue)] px-5 py-3 text-sm font-semibold text-[var(--color-paper)] transition-transform hover:-translate-y-1"
        >
          {copy.fields.submit} <span aria-hidden="true">↗</span>
        </button>
      </form>
    </div>
    <aside class="border-t-4 border-[var(--color-green)] pt-5">
      <h2 class="display text-3xl">{copy.detailsTitle}</h2>
      <dl class="mt-6">
        {copy.details.map((detail) => (
          <div class="border-b rule py-4">
            <dt class="eyebrow">{detail.label}</dt>
            <dd class="mt-1 text-[var(--color-ink-soft)]">
              {detail.href ? (
                <a
                  href={detail.href}
                  target={detail.href.startsWith('http') ? '_blank' : undefined}
                  rel={detail.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="text-[var(--color-blue)] underline decoration-[var(--color-orange)] underline-offset-4"
                >
                  {detail.value}
                </a>
              ) : (
                detail.value
              )}
            </dd>
          </div>
        ))}
      </dl>
    </aside>
  </section>
</Layout>
