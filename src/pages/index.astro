---
import HeroVideo from '../components/HeroVideo.astro';
import HeroTextAnimation from '../components/HeroTextAnimation.astro';
import SiteImage from '../components/SiteImage.astro';
import SupplierCarousel from '../components/SupplierCarousel.astro';
import { content } from '../data/content';
import Layout from '../layouts/Layout.astro';
import { localizedPath } from '../lib/i18n';

const locale = 'ca';
const copy = content[locale];
---

<Layout locale={locale} title={copy.home.title} description={copy.home.description}>
  <section class="home-hero home-hero-video">
    <HeroVideo />
    <div class="page-frame hero-content py-12 sm:py-16 lg:py-20" data-hero-content>
      <div class="max-w-3xl">
        <h1 class="display max-w-3xl text-6xl leading-[0.91] sm:text-8xl" data-hero-animate>
          {copy.home.heading}
        </h1>
        <p
          class="mt-8 max-w-xl text-lg leading-relaxed text-[rgba(245,241,232,0.86)] sm:text-xl"
          data-hero-animate
        >
          {copy.home.intro}
        </p>
        <div class="mt-10 flex flex-wrap gap-5 text-sm font-semibold" data-hero-animate>
          <a
            href={localizedPath(locale, 'about')}
            class="bg-[var(--color-orange)] px-5 py-3 text-[var(--color-ink)] no-underline transition-transform hover:-translate-y-1"
          >
            {copy.home.primaryAction}
          </a>
          <a
            href={localizedPath(locale, 'contact')}
            class="px-1 py-3 text-[var(--color-paper)] underline decoration-[var(--color-orange)] decoration-2 underline-offset-4 hover:text-[var(--color-orange)]"
          >
            {copy.home.secondaryAction} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p
          class="hero-footnote mt-12 max-w-sm text-sm leading-relaxed text-[rgba(245,241,232,0.76)]"
          data-hero-animate
        >
          <span class="hero-footnote-mark" aria-hidden="true"></span>
          Distribució local i nacional amb atenció personalitzada.
        </p>
      </div>
    </div>
    <HeroTextAnimation />
  </section>

  <section class="signal-band border-y rule bg-[var(--color-paper-deep)]">
    <div class="page-frame grid gap-8 py-10 sm:grid-cols-[0.72fr_1.28fr] sm:items-end sm:py-14">
      <h2 class="display max-w-sm text-4xl leading-none sm:text-5xl">
        Una distribució que es fa visible.
      </h2>
      <p class="max-w-2xl text-xl leading-relaxed text-[var(--color-ink-soft)]">
        Posem en moviment productes, marques i relacions perquè arribin amb criteri, proximitat i
        una manera clara de fer.
      </p>
    </div>
  </section>

  <section class="page-frame service-section py-16 sm:py-24">
    <div
      class="section-heading flex flex-col gap-5 border-b rule pb-6 sm:flex-row sm:items-end sm:justify-between"
    >
      <h2 class="display max-w-xl text-5xl leading-none sm:text-6xl">Servei que es nota.</h2>
    </div>
    <div class="service-list mt-2">
      {copy.home.services.map((service) => (
        <article class="service-row grid gap-4 border-b rule py-7 sm:grid-cols-[minmax(15rem,0.7fr)_1.3fr] sm:items-center">
          <h3 class="display text-3xl sm:text-4xl">{service.title}</h3>
          <p class="max-w-xl text-[var(--color-ink-soft)]">{service.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="supplier-section border-y rule bg-[var(--color-blue)] text-[var(--color-paper)]">
    <div class="page-frame py-16 sm:py-24">
      <div class="grid gap-8 sm:grid-cols-[0.7fr_1.3fr] sm:items-end">
        <div>
          <p class="supplier-kicker">Producte i origen</p>
          <h2 class="display mt-4 max-w-sm text-5xl leading-none sm:text-6xl">
            Marques que donen forma al recorregut.
          </h2>
        </div>
        <div class="sm:pb-2">
          <p class="max-w-xl text-lg leading-relaxed text-[rgba(245,241,232,0.78)]">
            Una selecció de marques i proveïdors que expliquen el nostre catàleg des del producte
            real.
          </p>
          <a
            href={localizedPath(locale, 'brands')}
            class="mt-7 inline-block whitespace-nowrap font-semibold text-[var(--color-paper)] underline decoration-[var(--color-orange)] decoration-2 underline-offset-4"
          >
            <span>Veure totes les marques&nbsp;<span aria-hidden="true">↗</span></span>
          </a>
        </div>
      </div>

      <SupplierCarousel locale={locale} />
    </div>
  </section>

  <section class="page-frame gallery-section py-16 sm:py-24">
    <div
      class="section-heading flex flex-col gap-5 border-b rule pb-6 sm:flex-row sm:items-end sm:justify-between"
    >
      <h2 class="display max-w-xl text-5xl leading-none sm:text-6xl">Una mirada al dia a dia.</h2>
      <span class="max-w-xs text-sm leading-relaxed text-[var(--color-ink-soft)]">
        La distribució també forma part del producte.
      </span>
    </div>
    <div class="gallery-grid mt-8">
      <figure class="gallery-feature overflow-hidden">
        <SiteImage
          src={copy.home.gallery[0].src}
          alt={copy.home.gallery[0].alt}
          sizes="(min-width: 801px) 60vw, 100vw"
        />
        <figcaption>El camí també explica com treballem.</figcaption>
      </figure>
      <div class="gallery-stack">
        <figure class="gallery-secondary overflow-hidden">
          <SiteImage
            src={copy.home.gallery[1].src}
            alt={copy.home.gallery[1].alt}
            sizes="(min-width: 801px) 30vw, 50vw"
          />
        </figure>
        <figure class="gallery-secondary overflow-hidden">
          <SiteImage
            src={copy.home.gallery[2].src}
            alt={copy.home.gallery[2].alt}
            sizes="(min-width: 801px) 30vw, 50vw"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="page-frame pb-8 sm:pb-16">
    <div
      class="contact-band grid gap-8 border-t-4 border-[var(--color-green)] pt-8 sm:grid-cols-[1fr_1fr] sm:items-end"
    >
      <h2 class="display max-w-lg text-5xl leading-none sm:text-6xl">{copy.home.contactTitle}</h2>
      <div>
        <p class="max-w-md text-lg text-[var(--color-ink-soft)]">{copy.home.contactBody}</p>
        <a
          href={localizedPath(locale, 'contact')}
          class="mt-6 inline-block font-semibold text-[var(--color-blue)] underline decoration-[var(--color-orange)] decoration-2 underline-offset-4"
        >
          {copy.home.contactAction} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
