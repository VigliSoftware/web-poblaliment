---
import PageIntro from '../components/PageIntro.astro';
import CellarScrollCue from '../components/CellarScrollCue.astro';
import SiteImage from '../components/SiteImage.astro';
import SupplierMark from '../components/SupplierMark.astro';
import { content } from '../data/content';
import { suppliers } from '../data/suppliers';
import Layout from '../layouts/Layout.astro';

const locale = 'ca';
const copy = content[locale].cellar;
const wineries = suppliers.filter((supplier) => supplier.category === 'Celler');
const moritz = suppliers.find((supplier) => supplier.name === 'Moritz');
---

<Layout locale={locale} page="cellar" title={copy.title} description={copy.description}>
  <div class="cellar-hero-stage">
    <PageIntro
      heading={copy.heading}
      intro={copy.intro}
      image="/images/sumarroca.jpg"
      imageAlt={copy.imageAlt}
      imageCaption={copy.imageCaption}
      compact
    />

    <div class="cellar-scroll-cue-spacing">
      <CellarScrollCue locale={locale} />
    </div>
  </div>

  <section id="cellar-selection" class="page-frame cellar-directory py-12 sm:py-24" data-reveal>
    <div class="cellar-heading">
      <h2 class="display" data-cellar-heading>Vins i escumosos</h2>
      <p data-cellar-copy>
        Una selecció de cellers amb identitat pròpia, pensada per donar visibilitat a cada origen.
      </p>
    </div>
    <div class="cellar-suppliers">
      {wineries.map((supplier) => (
        <article class="cellar-supplier">
          <SupplierMark supplier={supplier} />
          <h3 class="display">{supplier.name}</h3>
          {supplier.website && (
            <a href={supplier.website} target="_blank" rel="noopener noreferrer">
              Visita el celler <span aria-hidden="true">↗</span>
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  {moritz && (
    <section class="beer-feature border-y rule" data-reveal>
      <div class="page-frame beer-feature-grid">
        <figure>
          <SiteImage
            src="/images/moritz-pirineus.jpg"
            alt="Cerveses Moritz al cor del Pirineu"
            sizes="(min-width: 801px) 58vw, 100vw"
          />
        </figure>
        <div class="beer-feature-copy">
          <img
            class="beer-brand-logo"
            src="https://moritz.com/static/version1792476927/frontend/Hiberus/moritz/ca_ES/images/logo.svg"
            alt="Moritz"
            width="544"
            height="149"
            loading="lazy"
            decoding="async"
          />
          <h2 class="display">La nostra cervesa.</h2>
          <p>
            Una marca de cervesa amb caràcter propi dins la selecció de Poblaliment, distribuïda amb
            la mateixa proximitat i continuïtat que defineix les nostres rutes.
          </p>
          {moritz.website && (
            <a href={moritz.website} target="_blank" rel="noopener noreferrer">
              Conèixer Moritz <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </section>
  )}
</Layout>
