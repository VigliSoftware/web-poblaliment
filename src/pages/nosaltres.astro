---
import PageIntro from '../components/PageIntro.astro';
import SiteImage from '../components/SiteImage.astro';
import { content } from '../data/content';
import Layout from '../layouts/Layout.astro';

const locale = 'ca';
const copy = content[locale].about;
---

<Layout locale={locale} title={copy.title} description={copy.description}>
  <PageIntro
    heading={copy.heading}
    intro={copy.intro}
    image="/images/about-route.jpeg"
    imageAlt={copy.imageAlt}
    imageCaption={copy.imageCaption}
  />

  <section class="page-frame py-16 sm:py-24" data-reveal>
    <div class="grid gap-8 border-t rule pt-8 sm:grid-cols-[0.65fr_1.35fr]">
      <h2 class="display text-4xl sm:text-5xl">Des de l’abril de 1999.</h2>
      <div
        class="max-w-2xl space-y-5 justify-self-end text-lg leading-relaxed text-[var(--color-ink-soft)]"
      >
        <p>
          Poblaliment S.L. va néixer a la Pobla de Segur, al cor del Pallars Jussà. Més de 25 anys
          després, continuem creixent al costat dels negocis i les persones del territori.
        </p>
        <p>
          Seleccionem i distribuïm vins, begudes i productes gourmet a bars, restaurants, càmpings,
          hotels, carnisseries, botigues especialitzades i particulars.
        </p>
        <p>
          Treballem amb productors i marques de confiança per oferir qualitat, continuïtat i una
          resposta propera a cada client.
        </p>
      </div>
    </div>
  </section>

  <section
    class="anniversary-section border-y rule bg-[var(--color-blue)] text-[var(--color-paper)]"
    data-reveal
  >
    <div class="page-frame grid gap-10 py-16 sm:grid-cols-2 sm:items-center sm:py-24">
      <div>
        <p class="supplier-kicker">25è aniversari</p>
        <h2 class="display mt-4 text-5xl leading-none sm:text-6xl">
          Una cervesa feta per celebrar el camí.
        </h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-[rgba(245,241,232,0.78)]">
          Per celebrar els 25 anys de Poblaliment vam crear PIGAL, una cervesa artesanal pròpia que
          resumeix l’origen, el territori i les relacions construïdes durant tots aquests anys.
        </p>
      </div>
      <figure class="anniversary-image overflow-hidden sm:-mt-6">
        <SiteImage
          src="/images/products-ubla.jpeg"
          alt="Llaunes i gots de cervesa artesanal PIGAL sobre una barra"
          class="anniversary-photo"
          sizes="(min-width: 640px) 50vw, 100vw"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="page-frame py-16 sm:py-24" data-reveal>
    <div class="grid gap-8 sm:grid-cols-[0.65fr_1.35fr]">
      <h2 class="display text-4xl sm:text-5xl">{copy.valuesTitle}</h2>
      <div>
        {copy.values.map((value) => (
          <article class="grid gap-3 border-b rule py-6 first:pt-0 sm:grid-cols-[0.7fr_1.3fr]">
            <h3 class="display text-3xl">{value.title}</h3>
            <p class="max-w-xl text-[var(--color-ink-soft)]">{value.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
