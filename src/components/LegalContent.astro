---
import type { Locale } from '../lib/i18n';

const { locale } = Astro.props as { locale: Locale };
const copy = Astro.locals.site.content[locale].legal;
---

<header class="page-frame py-16 sm:py-24">
  <h1 class="display max-w-4xl text-5xl leading-[0.96] sm:text-7xl">{copy.heading}</h1>
  <p class="mt-7 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)]">{copy.intro}</p>
</header>

<div class="page-frame legal-layout pb-16 sm:pb-24">
  <nav class="legal-index" aria-label={copy.indexLabel}>
    <a href="#avis-legal">{copy.notice.heading}</a>
    <a href="#privacitat">{copy.privacy.heading}</a>
    <a href="#cookies">{copy.cookies.heading}</a>
  </nav>

  <div class="legal-content">
    <section id="avis-legal" data-reveal>
      <h2 class="display">{copy.notice.heading}</h2>
      <p class="whitespace-pre-line">{copy.notice.owner}</p>
      <p>
        {copy.notice.contactLabel}{' '}
        <a href={copy.notice.email.href}>{copy.notice.email.value}</a>{' '}
        {copy.notice.contactJoin}{' '}
        <a href={copy.notice.phone.href}>{copy.notice.phone.value}</a>.
      </p>
      <p class="whitespace-pre-line">{copy.notice.conditions}</p>
      <p class="whitespace-pre-line">{copy.notice.intellectualProperty}</p>
    </section>

    <section id="privacitat" data-reveal>
      <h2 class="display">{copy.privacy.heading}</h2>
      <p class="whitespace-pre-line">{copy.privacy.intro}</p>
      <h3>{copy.privacy.purposeHeading}</h3>
      <p class="whitespace-pre-line">{copy.privacy.purposeBody}</p>
      <h3>{copy.privacy.retentionHeading}</h3>
      <p class="whitespace-pre-line">{copy.privacy.retentionBody}</p>
      <h3>{copy.privacy.rightsHeading}</h3>
      <p class="whitespace-pre-line">{copy.privacy.rightsBody}</p>
    </section>

    <section id="cookies" data-reveal>
      <h2 class="display">{copy.cookies.heading}</h2>
      <p class="whitespace-pre-line">{copy.cookies.usage}</p>
      <p class="whitespace-pre-line">{copy.cookies.externalServices}</p>
      <p>{copy.cookies.lastUpdated}</p>
    </section>
  </div>
</div>
