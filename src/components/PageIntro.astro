---
import { getPageImage, type PageImageSlot } from '../data/page-images';
import { imageDimensions } from '../lib/images';
import MotionVisual from './MotionVisual';

interface Props {
  heading: string;
  intro: string;
  image: string;
  imageSlot?: PageImageSlot;
  imageAlt: string;
  imageCaption: string;
  compact?: boolean;
}

const { heading, intro, image, imageSlot, imageAlt, imageCaption, compact = false } = Astro.props;
const resolved = imageSlot ? getPageImage(Astro.locals.site.images, imageSlot) : undefined;
const dimensions = resolved ?? imageDimensions[image];

if (!dimensions) {
  throw new Error(`Missing image dimensions for ${image}`);
}
---

<section class:list={['page-frame page-intro py-16 sm:py-24', compact ? 'pb-12' : '']}>
  <div class="hero-grid items-end">
    <div class="max-w-3xl sm:pb-36">
      <h1 class="display max-w-3xl text-5xl leading-[0.96] sm:text-7xl">{heading}</h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-[var(--color-ink-soft)] sm:text-xl">
        {intro}
      </p>
    </div>
    <MotionVisual
      client:load
      src={resolved?.src ?? image}
      alt={imageAlt}
      caption={imageCaption}
      width={dimensions.width}
      height={dimensions.height}
      className="hero-image page-intro-image"
    />
  </div>
</section>
