---
import { suppliers } from '../data/suppliers';
import { localizedPath, type Locale } from '../lib/i18n';
import SupplierMark from './SupplierMark.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const featured = suppliers.filter((supplier) => supplier.principal);
const isSpanish = locale === 'es';
---

<div class="featured-suppliers">
  {featured.map((supplier) => {
    const page = supplier.category === 'Cerveses' ? 'cellar' : 'food';
    return (
      <a class="featured-supplier" href={localizedPath(locale, page)}>
        {supplier.name === 'Moritz' ? (
          <span class="supplier-mark supplier-mark--transparent" aria-hidden="true">
            <img
              src="/images/moritz-mark-transparent.png"
              alt=""
              width="1351"
              height="1164"
              loading="lazy"
              decoding="async"
            />
          </span>
        ) : (
          <SupplierMark supplier={supplier} />
        )}
        <span>
          <strong>{supplier.name}</strong>
          <small>{isSpanish ? 'Marca principal' : 'Marca principal'}</small>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
    );
  })}
</div>
