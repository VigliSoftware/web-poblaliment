---
import { localizedPath, type Locale } from '../lib/i18n';
import SupplierMark from './SupplierMark.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { featured, categories, content } = Astro.locals.site;
const sectionOf = (categoryId: string) =>
  categories.find((category) => category.id === categoryId)?.section;
---

<div class="featured-suppliers">
  {featured.map((supplier) => {
    const page = sectionOf(supplier.categoryId) === 'food' ? 'food' : 'cellar';
    return (
      <a class="featured-supplier" href={localizedPath(locale, page)}>
        <SupplierMark supplier={supplier} />
        <span>
          <strong>{supplier.name}</strong>
          <small>{content[locale].home.featuredLabel}</small>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
    );
  })}
</div>
