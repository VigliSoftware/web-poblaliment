---
import { localizedPath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = Astro.locals.site.content[locale];
---

<footer class="mt-24 border-t rule bg-[var(--color-paper-deep)]">
  <div
    class="page-frame grid gap-8 py-10 text-sm text-[var(--color-ink-soft)] sm:grid-cols-[1fr_auto] sm:items-end"
  >
    <div>
      <a
        href={localizedPath(locale, 'home')}
        class="display text-2xl text-[var(--color-ink)] no-underline"
      >
        {copy.footer.statement}
      </a>
      <p class="mt-2 text-xs">© <span data-current-year></span> Poblaliment</p>
      <nav
        class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-xs"
        aria-label={locale === 'ca' ? 'Informació legal' : 'Información legal'}
      >
        <a class="footer-legal-link" href={`${localizedPath(locale, 'legal')}#avis-legal`}>
          {locale === 'ca' ? 'Avís legal' : 'Aviso legal'}
        </a>
        <a class="footer-legal-link" href={`${localizedPath(locale, 'legal')}#privacitat`}>
          {locale === 'ca' ? 'Política de privacitat' : 'Política de privacidad'}
        </a>
        <a class="footer-legal-link" href={`${localizedPath(locale, 'legal')}#cookies`}>
          Política de cookies
        </a>
      </nav>
    </div>
    <a
      href="https://vigli.dev"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-baseline gap-1.5 text-[0.68rem] no-underline"
      aria-label={`${copy.footer.credit} Vigli.dev (${locale === 'ca' ? 's’obre en una pestanya nova' : 'se abre en una pestaña nueva'})`}
    >
      <span class="text-[var(--color-ink-soft)]">{copy.footer.credit}</span>
      <span
        class="font-semibold text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-orange)]"
      >
        Vigli.dev <span aria-hidden="true">↗</span>
      </span>
    </a>
  </div>
</footer>

<script>
const year = String(new Date().getFullYear());

for (const element of document.querySelectorAll<HTMLElement>('[data-current-year]')) {
  element.textContent = year;
}
</script>
