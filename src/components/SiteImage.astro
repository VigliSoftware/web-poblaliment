---
import { Image } from 'astro:assets';
import { getPageImage, type PageImageSlot } from '../data/page-images';
import { imageDimensions } from '../lib/images';

interface Props {
  src: string;
  slot?: PageImageSlot;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  sizes?: string;
}

const { src: fallbackSrc, slot, alt, class: className, loading = 'lazy', sizes } = Astro.props;
const resolved = slot ? getPageImage(Astro.locals.site.images, slot) : undefined;
const src = resolved?.src ?? fallbackSrc;
const dimensions = resolved ?? imageDimensions[src];

if (!dimensions) {
  throw new Error(`Missing image dimensions for ${src}`);
}
---

<Image
  src={src}
  alt={alt}
  width={dimensions.width}
  height={dimensions.height}
  loading={loading}
  decoding="async"
  sizes={sizes}
  class={className}
/>
