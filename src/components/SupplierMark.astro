---
import type { Supplier } from '../data/suppliers';
import { faviconFor } from '../lib/site-data';
import { imageSrcset } from '../lib/optimized-media';

interface Props {
  supplier: Supplier;
  class?: string;
  sizes?: string;
}

const { supplier, class: className = '', sizes = '64px' } = Astro.props;
const initial = supplier.name.trim().charAt(0).toLocaleUpperCase('ca');
const customBrand = ['Choví', 'Chovi'].includes(supplier.name)
  ? 'chovi'
  : supplier.name === 'Olis Pons'
    ? 'pons'
    : ['La Granja', 'La granja'].includes(supplier.name)
      ? 'lagranja'
      : supplier.name === 'Tamaric · Dispocat'
        ? 'tamaric'
        : supplier.name === 'Benfumat'
          ? 'benfumat'
          : supplier.name === 'Millàs'
            ? 'millas'
            : undefined;
const src = supplier.logo ?? faviconFor(supplier.website);
---

<span
  class:list={[
    'supplier-mark',
    supplier.logo && 'supplier-mark--transparent',
    customBrand && `supplier-mark--${customBrand}`,
    className,
  ]}
  aria-hidden="true"
>
  {src ? (
    <img
      class={customBrand ? 'p-2' : undefined}
      src={src}
      srcset={imageSrcset(src)}
      sizes={sizes}
      alt=""
      width="64"
      height="64"
      loading="lazy"
      decoding="async"
    />
  ) : (
    <span>{initial}</span>
  )}
</span>
