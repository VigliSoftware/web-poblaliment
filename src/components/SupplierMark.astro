---
import type { Supplier } from '../data/suppliers';
import { faviconFor } from '../lib/site-data';

interface Props {
  supplier: Supplier;
  class?: string;
}

const { supplier, class: className = '' } = Astro.props;
const initial = supplier.name.trim().charAt(0).toLocaleUpperCase('ca');
const src = supplier.logo ?? faviconFor(supplier.website);
---

<span
  class:list={['supplier-mark', supplier.logo && 'supplier-mark--transparent', className]}
  aria-hidden="true"
>
  {src ? (
    <img src={src} alt="" width="64" height="64" loading="lazy" decoding="async" />
  ) : (
    <span>{initial}</span>
  )}
</span>
