---
import NoveltyFeature from '../components/NoveltyFeature.astro';
import { visibleNovelties } from '../lib/novelties';
import CellarScrollCue from '../components/CellarScrollCue.astro';
import SiteImage from '../components/SiteImage.astro';
import SupplierRail from '../components/SupplierRail.astro';
import Layout from '../layouts/Layout.astro';
import type { Locale } from '../lib/i18n';
import { categoryName } from '../lib/site-data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { content, categories, suppliers, novelties } = Astro.locals.site;
const copy = content[locale].food;
const items = visibleNovelties(novelties, 'food');
const heading = novelties.heading[locale];
const families = categories
  .filter((category) => category.section === 'food')
  .map((category) => ({
    name: categoryName(category, locale),
    suppliers: suppliers.filter((supplier) => supplier.categoryId === category.id),
  }))
  .filter((family) => family.suppliers.length > 0);
---

<Layout locale={locale} page="food" title={copy.title} description={copy.description}>
  <div class="food-hero-stage">
    <section class="page-frame page-intro food-intro pt-12 pb-12 sm:pt-16">
      <SiteImage
        src="/images/Gemini_Generated_Image_bpvsh8bpvsh8bpvs.jpeg"
        slot="foodHero"
        alt={copy.imageAlt}
        class="aspect-[4/3] w-full object-cover sm:aspect-[40/17]"
        sizes="(min-width: 1312px) 1280px, calc(100vw - 32px)"
        loading="eager"
      />
      <div class="mx-auto mt-10 max-w-4xl text-center sm:mt-12">
        <h1 class="display text-5xl leading-[0.96] sm:text-7xl">{copy.heading}</h1>
        <p
          class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)] sm:text-xl"
        >
          {copy.intro}
        </p>
      </div>
    </section>

    <div class="food-scroll-cue-spacing">
      <CellarScrollCue target={items.length ? 'novetats' : 'food-filter'} label={copy.scrollCue} />
    </div>
  </div>

  {items.length > 0 && (
    <section id="novetats" class="novelty-section border-y rule" data-reveal>
      <div class="page-frame mb-12 sm:mb-16">
        {heading.kicker && <p class="supplier-kicker">{heading.kicker}</p>}
        <h2 class="display mt-3 text-4xl leading-tight sm:text-6xl text-[var(--color-paper)]">
          {heading.title}
        </h2>
      </div>
      <div class="space-y-16 sm:space-y-24">
        {items.map((novelty, index) => (
          <NoveltyFeature novelty={novelty} locale={locale} reversed={index % 2 === 1} />
        ))}
      </div>
    </section>
  )}

  <section class="page-frame food-directory py-12 sm:py-24">
    <nav id="food-filter" class="food-category-nav" aria-label={copy.filterLabel}>
      {families.map((family, index) => <a href={`#familia-${index}`}>{family.name}</a>)}
    </nav>

    {families.map((family, index) => (
      <section class="food-category" id={`familia-${index}`} data-reveal>
        <div class="food-category-heading">
          <h2 class="display">{family.name}</h2>
          <span>
            {family.suppliers.length} {copy.supplierCount}
          </span>
        </div>
        <SupplierRail locale={locale} label={family.name} suppliers={family.suppliers} />
      </section>
    ))}
  </section>
</Layout>
