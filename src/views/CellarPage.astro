---
import NoveltyFeature from '../components/NoveltyFeature.astro';
import { noveltyHeading, visibleNovelties } from '../lib/novelties';
import CellarScrollCue from '../components/CellarScrollCue.astro';
import SiteImage from '../components/SiteImage.astro';
import SupplierMark from '../components/SupplierMark.astro';
import { getPageImage } from '../data/page-images';
import Layout from '../layouts/Layout.astro';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { content, categories, suppliers, images, novelties } = Astro.locals.site;
const copy = content[locale].cellar;
const items = visibleNovelties(novelties, 'cellar');
const heading = noveltyHeading(novelties, 'cellar', locale);
const inSection = (section: string) =>
  suppliers.filter(
    (supplier) =>
      categories.find((category) => category.id === supplier.categoryId)?.section === section,
  );
const wineries = inSection('cellar');
const beer = inSection('beer')[0];
const beerLogo = getPageImage(images, 'cellarBeerLogo');
---

<Layout locale={locale} page="cellar" title={copy.title} description={copy.description}>
  <div class="cellar-hero-stage">
    <section class="page-frame page-intro cellar-intro pt-12 pb-12 sm:pt-16">
      <SiteImage
        src="/images/pexels-allen-cullen-2740212-5934491.jpg"
        slot="cellarHero"
        alt={copy.imageAlt}
        class="aspect-[4/3] w-full object-cover sm:aspect-[40/17]"
        sizes="(min-width: 1312px) 1280px, calc(100vw - 32px)"
        loading="eager"
      />
      <div class="mx-auto mt-10 max-w-4xl text-center sm:mt-12">
        <h1 class="display text-5xl leading-[0.96] sm:text-7xl">{copy.heading}</h1>
        <p
          class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)] sm:text-xl"
        >
          {copy.intro}
        </p>
      </div>
    </section>

    <div class="cellar-scroll-cue-spacing">
      <CellarScrollCue
        target={items.length ? 'novetat' : 'cellar-selection'}
        label={copy.scrollCue}
      />
    </div>
  </div>

  {items.length > 0 && (
    <section id="novetat" class="novelty-section border-y rule" data-reveal>
      <div class="page-frame mb-12 sm:mb-16">
        {heading.kicker && <p class="supplier-kicker">{heading.kicker}</p>}
        <h2 class="display mt-3 text-4xl leading-tight sm:text-6xl text-[var(--color-paper)]">
          {heading.title}
        </h2>
      </div>
      <div class="space-y-16 sm:space-y-24">
        {items.map((novelty, index) => (
          <NoveltyFeature
            novelty={novelty}
            locale={locale}
            reversed={index % 2 === 1}
            heading="h3"
          />
        ))}
      </div>
    </section>
  )}

  <section id="cellar-selection" class="page-frame cellar-directory py-12 sm:py-24" data-reveal>
    <div class="cellar-heading">
      <h2 class="display" data-cellar-heading>{copy.winesTitle}</h2>
      <p data-cellar-copy>{copy.winesBody}</p>
    </div>
    <div class="cellar-suppliers">
      {wineries.map((supplier) => (
        <article class="cellar-supplier">
          <SupplierMark supplier={supplier} />
          <h3 class="display">{supplier.name}</h3>
          {supplier.website && (
            <a href={supplier.website} target="_blank" rel="noopener noreferrer">
              {copy.visitLabel} <span aria-hidden="true">↗</span>
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  {beer && (
    <section class="beer-feature border-y rule" data-reveal>
      <div class="page-frame beer-feature-grid">
        <figure>
          <SiteImage
            src="/images/moritz-selection.webp"
            slot="cellarBeer"
            alt={copy.beerImageAlt}
            sizes="(min-width: 801px) 58vw, 100vw"
          />
        </figure>
        <div class="beer-feature-copy">
          {beer.name === 'Moritz' || images.cellarBeerLogo ? (
            <img
              class="beer-brand-logo"
              src={beerLogo.src}
              alt={beer.name}
              width={beerLogo.width}
              height={beerLogo.height}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <p class="display text-4xl">{beer.name}</p>
          )}
          <h2 class="display">{copy.beerTitle}</h2>
          <p>{copy.beerBody}</p>
          {beer.website && (
            <a href={beer.website} target="_blank" rel="noopener noreferrer">
              {copy.beerLink} <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </section>
  )}
</Layout>
