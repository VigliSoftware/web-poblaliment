---
import SiteImage from '../components/SiteImage.astro';
import Layout from '../layouts/Layout.astro';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = Astro.locals.site.content[locale].about;
---

<Layout locale={locale} title={copy.title} description={copy.description}>
  <section class="page-frame about-intro pt-12 sm:pt-16">
    <SiteImage
      src="/images/about-dawn.jpeg"
      slot="aboutHero"
      alt={copy.imageAlt}
      class="aspect-[4/3] w-full object-cover object-[center_60%] sm:aspect-[16/9]"
      sizes="(min-width: 1312px) 1280px, calc(100vw - 32px)"
      loading="eager"
    />
    <div class="mx-auto mt-10 max-w-4xl text-center sm:mt-12">
      <h1 class="display text-5xl leading-[0.96] sm:text-7xl">{copy.heading}</h1>
      <p
        class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)] sm:text-xl"
      >
        {copy.intro}
      </p>
    </div>
  </section>

  <section class="page-frame py-16 sm:py-24" data-reveal>
    <div class="grid gap-8 border-t rule pt-8 sm:grid-cols-[0.65fr_1.35fr]">
      <h2 class="display text-4xl sm:text-5xl">{copy.historyTitle}</h2>
      <div
        class="max-w-2xl space-y-5 justify-self-end text-lg leading-relaxed text-[var(--color-ink-soft)]"
      >
        {copy.historyParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section
    class="anniversary-section border-y rule bg-[var(--color-blue)] text-[var(--color-paper)]"
    data-reveal
  >
    <div class="page-frame grid gap-10 py-16 sm:grid-cols-2 sm:items-center sm:py-24">
      <div>
        <p class="supplier-kicker">{copy.anniversaryKicker}</p>
        <h2 class="display mt-4 text-5xl leading-none sm:text-6xl">{copy.anniversaryTitle}</h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-[rgba(245,241,232,0.78)]">
          {copy.anniversaryBody}
        </p>
      </div>
      <figure class="anniversary-image overflow-hidden sm:-mt-6">
        <SiteImage
          src="/images/products-ubla.jpeg"
          slot="aboutAnniversary"
          alt={copy.anniversaryImageAlt}
          class="anniversary-photo"
          sizes="(min-width: 640px) 50vw, 100vw"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="page-frame py-16 sm:py-24" data-reveal>
    <div class="grid gap-8 sm:grid-cols-[0.65fr_1.35fr]">
      <h2 class="display text-4xl sm:text-5xl">{copy.valuesTitle}</h2>
      <div>
        {copy.values.map((value) => (
          <article class="grid gap-3 border-b rule py-6 first:pt-0 sm:grid-cols-[0.7fr_1.3fr]">
            <h3 class="display text-3xl">{value.title}</h3>
            <p class="max-w-xl text-[var(--color-ink-soft)]">{value.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
